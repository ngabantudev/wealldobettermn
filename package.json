  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "data:wards": "node scripts/fetch-wards.mjs",
    "data:mayors": "node scripts/fetch-mayors.mjs",
    "data:commissioners": "node scripts/fetch-commissioners.mjs",
