{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "mn-civic-watch",
  "routes": [
    { "pattern": "wealldobettermn.org", "custom_domain": true }
  ],
  // Adding an explicit `routes` entry above made wrangler default
  // `workers_dev`/`preview_urls` to false — Cloudflare's normal assumption
  // once you've declared a "real" route is that you no longer want the
  // .workers.dev subdomain. That assumption breaks our own setup: Workers
  // Builds' per-branch/per-commit Preview URLs (the whole point of the
  // trigger fix earlier this thread) run on exactly that subdomain, and so
  // does the current production alias every earlier link in this
  // conversation points at. Both stay on explicitly.
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mn-civic-watch"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Community Contribution Pipeline (AGENTS.md §2.6) — this app's first
  // Cloudflare data binding. Provisioned 2026-08-09 via
  // `npx wrangler d1 create wealldobettermn-community` against the
  // maintainer's own Cloudflare account.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wealldobettermn-community",
      "database_id": "c30e3834-e847-4ba5-ae18-0506135ca558",
      "migrations_dir": "migrations"
    }
  ],
  // Officeholder extraction for community submissions (AGENTS.md §2.6) —
  // deliberately Workers AI, not a proprietary external LLM key, per §0.8
  // ("no proprietary API keys in the critical path"). No further setup
  // needed beyond this binding; Workers AI is billed per-account, not
  // per-key.
  "ai": {
    "binding": "AI"
  }
  // A `triggers.crons` entry for the weekly dedup/expiry purge (AGENTS.md
  // §2.6 phase 2) is deliberately NOT added yet — it needs
  // @opennextjs/cloudflare's scheduled() support verified first (see the
  // implementation plan); adding an unverified cron trigger here would
  // silently no-op rather than fail loudly, which this repo treats as
  // worse than not having it yet.
}
